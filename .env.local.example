# Copia este archivo a .env.local y rellena los valores reales.
# .env.local no se sube a git (ver .gitignore).

# Stripe — https://dashboard.stripe.com/apikeys
# Usa una clave "sk_test_..." mientras pruebas, y "sk_live_..." cuando esté listo para cobrar de verdad.
STRIPE_SECRET_KEY=sk_test_...

# URL pública del sitio, para construir los enlaces de éxito/cancelación de Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
# Necesario para enviar por email el pedido (datos + fotos) a Chamberí 54.
RESEND_API_KEY=re_...

# Email donde queréis recibir los pedidos con las fotos de los perros.
STUDIO_ORDER_EMAIL=pedidos@chamberi54.com

# Remitente que verá el cliente al recibir la confirmación (debe ser de un dominio verificado en Resend).
STUDIO_FROM_EMAIL="Chamberí 54 <pedidos@chamberi54.com>"
